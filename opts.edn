{
 ;; Site opts
 :http-port 1887
 :site-out-dir "public"
 :site-templates-dir "templates"
 :site-base-template ["{{site-templates-dir}}" "base.html"]
 :maria-src-base-url "raw.githubusercontent.com/jmglov/jmglov.net/main/"
 :site-rendering-system-files ["lib.clj" "tasks.clj" "{{templates-dir}}"]

 ;; Blog opts
